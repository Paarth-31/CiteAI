FLASK_APP=manage.py
FLASK_CONFIG=development
DATABASE_URL=postgresql+psycopg2://citeai:change-me@localhost:5432/citeai_main
AUTH_DATABASE_URL=postgresql+psycopg2://citeai:change-me@localhost:5432/citeai_auth
# Replace this before running outside a local development machine.
JWT_SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Relative paths are resolved from the backend working directory.
UPLOAD_FOLDER=storage/uploads
MAX_UPLOAD_SIZE_MB=50
# Use cpu on machines without a supported accelerator.
MODEL_DEVICE=auto
SENTENCE_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
LEGALBERT_MODEL_NAME=law-ai/InLegalBERT
LEGALBERT_MAX_LENGTH=512
FAISS_TOP_K=20
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
INDIAN_KANOON_API_TOKEN=
NLI_MODEL_NAME=typeform/distilbert-base-uncased-mnli

# Optional isolated databases for tests.
# TEST_DATABASE_URL=postgresql+psycopg2://citeai:change-me@localhost:5432/citeai_main_test
# TEST_AUTH_DATABASE_URL=postgresql+psycopg2://citeai:change-me@localhost:5432/citeai_auth_test
